{
  // 記事 Markdown の lint。CI から `npm run lint:md` で実行する。
  "config": {
    // 日本語は単語間に空白がなく、80 桁制約が意味を持たない
    "MD013": false,
    // H1 は frontmatter title と本文の 1 つ。重複検査は scripts/check-content.ts が担う
    "MD025": { "front_matter_title": "" },
    // コードブロック内のタブは本文ではなく内容
    "MD010": { "code_blocks": false },
    // 日本語見出しの末尾「。」を許す
    "MD026": false,
    // 「参考」「まとめ」など、同階層でなければ重複見出しを許す
    "MD024": { "siblings_only": true },
    // 本文中で使う HTML
    "MD033": { "allowed_elements": ["br", "details", "summary", "img", "kbd"] }
  },
  "globs": ["src/content/pages/**/*.md"]
}
