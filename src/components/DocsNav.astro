---
interface Node {
  id: string;
  title: string;
  children: Node[];
}
interface Props {
  nodes: Node[];
  current: string;
}
const { nodes, current } = Astro.props;
---
<details class="docs-nav" open>
  <summary>ドキュメント目次</summary>
  <a class="home" href="/">← ホーム</a>
  <ul>
    {nodes.map((n) => (
      <li class:list={[{ group: n.children.length > 0 }]}>
        <a href={`/${n.id}/`} aria-current={n.id === current ? 'page' : undefined}>{n.title}</a>
        {n.children.length > 0 && (
          <ul>
            {n.children.map((c) => (
              <li>
                <a href={`/${c.id}/`} aria-current={c.id === current ? 'page' : undefined}>{c.title}</a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</details>
